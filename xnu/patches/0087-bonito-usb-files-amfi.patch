diff --git a/bsd/dev/sweet_files.c b/bsd/dev/sweet_files.c
new file mode 100644
index 0000000..8209bf1
--- /dev/null
+++ b/bsd/dev/sweet_files.c
@@ -0,0 +1,325 @@
+/*
+ * File server for the running iOS root, over USB Ethernet: TCP
+ * 192.168.7.2:2223 (on the Mac: 127.0.0.1:2223 through FlameBridge,
+ * tools/flame-files.py). One request per connection, a header line then
+ * data:
+ *
+ *   PUT <path> <mode-octal> <size>\n<size bytes>  -> "OK <size>\n"  (root:wheel)
+ *   GET <path>\n                                  -> "OK <size>\n<bytes>"
+ *   MKDIR <path> <mode-octal>\n                   -> "OK\n"
+ *   LINK <target> <path>\n                        -> "OK\n"  (symlink)
+ *   RM <path>\n                                   -> "OK\n"
+ *   CHMOD <path> <mode-octal>\n                   -> "OK\n"
+ *
+ * Errors: "ERR <errno>\n". Paths have no spaces. Started with the USB
+ * gadget (sweet_usb.c) when the interface comes up.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/kernel.h>
+#include <sys/kauth.h>
+#include <sys/kpi_socket.h>
+#include <sys/socket.h>
+#include <sys/uio.h>
+#include <netinet/in.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <libkern/libkern.h>
+
+extern int sweet_vfs_mkdir(const char *path, int mode);
+extern int sweet_vfs_symlink(const char *target, const char *link);
+extern int sweet_vfs_unlink(const char *path);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_files_start(void);
+
+#define SF_BUF  (64 * 1024)
+
+static char *sf_buf;
+static int sf_chan;
+
+static void
+sf_sleep_ms(int ms)
+{
+	(void)tsleep(&sf_chan, PZERO, "sweetfiles", MAX(1, ms * hz / 1000));
+}
+
+static unsigned long long
+sf_dec(const char *p)
+{
+	unsigned long long v = 0;
+	while (*p == ' ') {
+		p++;
+	}
+	while (*p >= '0' && *p <= '9') {
+		v = v * 10 + (unsigned)(*p++ - '0');
+	}
+	return v;
+}
+
+static int
+sf_recv(socket_t so, void *buf, size_t len, size_t *got, int flags)
+{
+	struct iovec iov = { .iov_base = buf, .iov_len = len };
+	struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+	return sock_receive(so, &msg, flags, got);
+}
+
+static int
+sf_recv_all(socket_t so, void *buf, size_t len)
+{
+	size_t off = 0;
+	while (off < len) {
+		size_t got = 0;
+		int err = sf_recv(so, (char *)buf + off, len - off, &got, MSG_WAITALL);
+		if (err) {
+			return err;
+		}
+		if (got == 0) {
+			return ECONNRESET;
+		}
+		off += got;
+	}
+	return 0;
+}
+
+static int
+sf_send(socket_t so, const void *buf, size_t len)
+{
+	size_t off = 0;
+	while (off < len) {
+		struct iovec iov = { .iov_base = (char *)buf + off, .iov_len = len - off };
+		struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+		size_t sent = 0;
+		int err = sock_send(so, &msg, 0, &sent);
+		if (err) {
+			return err;
+		}
+		off += sent;
+	}
+	return 0;
+}
+
+static void
+sf_reply(socket_t so, int err, uint64_t n, bool with_n)
+{
+	char line[48];
+	int len = err ? snprintf(line, sizeof(line), "ERR %d\n", err) :
+	    with_n ? snprintf(line, sizeof(line), "OK %llu\n", n) : snprintf(line, sizeof(line), "OK\n");
+	(void)sf_send(so, line, (size_t)len);
+}
+
+/* Header line: up to '\n', read byte by byte so data after it stays queued. */
+static int
+sf_line(socket_t so, char *line, size_t max)
+{
+	size_t n = 0;
+	while (n + 1 < max) {
+		size_t got = 0;
+		int err = sf_recv(so, line + n, 1, &got, MSG_WAITALL);
+		if (err || got == 0) {
+			return err ? err : ECONNRESET;
+		}
+		if (line[n] == '\n') {
+			break;
+		}
+		n++;
+	}
+	line[n] = 0;
+	return 0;
+}
+
+static int
+sf_setattr(const char *path, int mode, bool owner)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_lookup(path, 0, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode & 07777);
+	if (owner) {
+		VATTR_SET(&va, va_uid, 0);
+		VATTR_SET(&va, va_gid, 0);
+	}
+	err = vnode_setattr(vp, &va, ctx);
+	vnode_put(vp);
+	return err;
+}
+
+static int
+sf_put(socket_t so, const char *path, int mode, uint64_t size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_open(path, O_CREAT | O_TRUNC | FWRITE, mode & 07777, 0, &vp, ctx);
+	uint64_t off = 0;
+	while (off < size) {
+		size_t chunk = (size_t)MIN((uint64_t)SF_BUF, size - off);
+		int rerr = sf_recv_all(so, sf_buf, chunk);
+		if (rerr) {
+			err = err ? err : rerr;
+			break;
+		}
+		if (!err) {
+			int resid = 0;
+			err = vn_rdwr(UIO_WRITE, vp, sf_buf, (int)chunk, (off_t)off, UIO_SYSSPACE, IO_UNIT,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+			if (!err && resid) {
+				err = EIO;
+			}
+		}
+		off += chunk;
+	}
+	if (vp != NULLVP) {
+		vnode_close(vp, FWRITE, ctx);
+	}
+	if (!err) {
+		err = sf_setattr(path, mode, true);
+	}
+	return err;
+}
+
+static int
+sf_get(socket_t so, const char *path)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	int err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (!err) {
+		err = vnode_size(vp, &size, ctx);
+	}
+	if (err) {
+		if (vp != NULLVP) {
+			vnode_close(vp, FREAD, ctx);
+		}
+		sf_reply(so, err, 0, false);
+		return err;
+	}
+	sf_reply(so, 0, (uint64_t)size, true);
+	for (off_t off = 0; off < size && !err;) {
+		int chunk = (int)MIN((off_t)SF_BUF, size - off), resid = 0;
+		err = vn_rdwr(UIO_READ, vp, sf_buf, chunk, off, UIO_SYSSPACE, IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!err) {
+			err = sf_send(so, sf_buf, (size_t)(chunk - resid));
+		}
+		off += chunk;
+	}
+	vnode_close(vp, FREAD, ctx);
+	return err;
+}
+
+static void
+sf_handle(socket_t so)
+{
+	static char line[1100];
+	char a[512], b[512];
+	unsigned long long n = 0;
+	int err = sf_line(so, line, sizeof(line));
+	if (err) {
+		return;
+	}
+	a[0] = b[0] = 0;
+	if (!strncmp(line, "PUT ", 4)) {
+		unsigned mode = 0644;
+		char *p = line + 4, *sp = strchr(p, ' ');
+		if (!sp || (size_t)(sp - p) >= sizeof(a)) {
+			sf_reply(so, EINVAL, 0, false);
+			return;
+		}
+		memcpy(a, p, (size_t)(sp - p));
+		a[sp - p] = 0;
+		mode = (unsigned)strtoul(sp + 1, &p, 8);
+		n = sf_dec(p);
+		err = sf_put(so, a, (int)mode, n);
+		printf("SWEET FILES: PUT %s %o %llu -> %d\n", a, mode, n, err);
+		sf_reply(so, err, n, true);
+		return;
+	}
+	if (!strncmp(line, "GET ", 4)) {
+		err = sf_get(so, line + 4);
+		printf("SWEET FILES: GET %s -> %d\n", line + 4, err);
+		return;
+	}
+	char *sp = strchr(line, ' ');
+	if (!sp) {
+		sf_reply(so, EINVAL, 0, false);
+		return;
+	}
+	*sp = 0;
+	char *arg1 = sp + 1, *arg2 = strchr(arg1, ' ');
+	if (arg2) {
+		*arg2++ = 0;
+	}
+	if (!strcmp(line, "MKDIR")) {
+		err = sweet_vfs_mkdir(arg1, arg2 ? (int)strtoul(arg2, NULL, 8) : 0755);
+		if (err == EEXIST) {
+			err = 0;
+		}
+	} else if (!strcmp(line, "LINK") && arg2) {
+		err = sweet_vfs_symlink(arg1, arg2);
+	} else if (!strcmp(line, "RM")) {
+		err = sweet_vfs_unlink(arg1);
+	} else if (!strcmp(line, "CHMOD") && arg2) {
+		err = sf_setattr(arg1, (int)strtoul(arg2, NULL, 8), false);
+	} else {
+		err = EINVAL;
+	}
+	printf("SWEET FILES: %s %s %s -> %d\n", line, arg1, arg2 ? arg2 : "", err);
+	sf_reply(so, err, 0, false);
+}
+
+static void
+sf_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	socket_t ls = NULL;
+	struct sockaddr_in me;
+	int one = 1;
+
+	sf_buf = kalloc_data(SF_BUF, Z_WAITOK);
+	for (;;) {
+		if (sock_socket(PF_INET, SOCK_STREAM, IPPROTO_TCP, NULL, NULL, &ls) == 0) {
+			(void)sock_setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+			bzero(&me, sizeof(me));
+			me.sin_len = sizeof(me);
+			me.sin_family = AF_INET;
+			me.sin_port = htons(2223);
+			me.sin_addr.s_addr = htonl(INADDR_ANY);
+			if (sock_bind(ls, (struct sockaddr *)&me) == 0 && sock_listen(ls, 4) == 0) {
+				break;
+			}
+			sock_close(ls);
+		}
+		ls = NULL;
+		sf_sleep_ms(1000);
+	}
+	printf("SWEET FILES: listening on tcp 2223\n");
+	for (;;) {
+		socket_t c = NULL;
+		if (sock_accept(ls, NULL, 0, 0, NULL, NULL, &c) != 0 || c == NULL) {
+			sf_sleep_ms(100);
+			continue;
+		}
+		sf_handle(c);
+		sock_close(c);
+	}
+}
+
+void
+sweet_files_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(sf_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_poke.c b/bsd/dev/sweet_poke.c
new file mode 100644
index 0000000..2465222
--- /dev/null
+++ b/bsd/dev/sweet_poke.c
@@ -0,0 +1,242 @@
+/*
+ * Register poke scripts: hardware experiments without a kernel rebuild.
+ * tools/mkpayload.py --poke FILE puts FILE in the ADT as /chosen/sweet-poke;
+ * a kernel thread runs it line by line and logs every step ("POKE:").
+ *
+ *   @SECS                  wait until SECS seconds after the timer started
+ *   r ADDR [N]             read N (default 1) 32-bit words
+ *   w ADDR VAL             write
+ *   m ADDR MASK VAL        read-modify-write: (old & ~MASK) | (VAL & MASK)
+ *   p ADDR MASK VAL MS     poll until (read & MASK) == VAL, at most MS ms
+ *   s MS                   sleep
+ *   # ...                  comment
+ *
+ * Numbers are hex with 0x, else decimal. Addresses are physical; each 4K
+ * page is mapped once (device memory). A read of an unclocked block hangs
+ * the SoC: the RAM log rescue (shim/ramlog.c) keeps the lines up to it.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <mach/mach_time.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_poke_start(void);
+void sweet_poke_run(const char *text, unsigned len);
+
+#define POKE_MAPS       32
+#define POKE_TICKS_S    19200000ULL     /* flame timer */
+
+static struct {
+	uint64_t page;
+	vm_offset_t va;
+} poke_map[POKE_MAPS];
+static const char *poke_script;
+static unsigned poke_len;
+
+static volatile uint32_t *
+poke_reg(uint64_t pa)
+{
+	uint64_t page = pa & ~0xfffULL;
+	for (unsigned i = 0; i < POKE_MAPS; i++) {
+		if (poke_map[i].va && poke_map[i].page == page) {
+			return (volatile uint32_t *)(poke_map[i].va + (pa & 0xfff));
+		}
+	}
+	for (unsigned i = 0; i < POKE_MAPS; i++) {
+		if (!poke_map[i].va) {
+			poke_map[i].va = ml_io_map((vm_offset_t)page, 0x1000);
+			poke_map[i].page = page;
+			return poke_map[i].va ? (volatile uint32_t *)(poke_map[i].va + (pa & 0xfff)) : NULL;
+		}
+	}
+	return NULL;
+}
+
+static uint32_t
+poke_rd(volatile uint32_t *r)
+{
+	uint32_t v = *r;
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+poke_wr(volatile uint32_t *r, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*r = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static void
+poke_sleep_ms(unsigned ms)
+{
+	delay((int)ms * 1000);
+}
+
+/* Parse one number; returns false at end of line. */
+static bool
+poke_num(const char **p, const char *end, uint64_t *out)
+{
+	const char *s = *p;
+	while (s < end && (*s == ' ' || *s == '\t')) {
+		s++;
+	}
+	if (s >= end || *s == '\n' || *s == '#') {
+		*p = s;
+		return false;
+	}
+	uint64_t v = 0;
+	unsigned base = 10;
+	if (s + 1 < end && s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) {
+		base = 16;
+		s += 2;
+	}
+	const char *d0 = s;
+	for (; s < end; s++) {
+		unsigned c = (unsigned char)*s, digit;
+		if (c >= '0' && c <= '9') {
+			digit = c - '0';
+		} else if (base == 16 && c >= 'a' && c <= 'f') {
+			digit = c - 'a' + 10;
+		} else if (base == 16 && c >= 'A' && c <= 'F') {
+			digit = c - 'A' + 10;
+		} else if (c == '_') {
+			continue;
+		} else {
+			break;
+		}
+		v = v * base + digit;
+	}
+	*p = s;
+	*out = v;
+	return s > d0;
+}
+
+static void
+poke_line(const char *s, const char *end, unsigned lineno)
+{
+	while (s < end && (*s == ' ' || *s == '\t')) {
+		s++;
+	}
+	if (s >= end || *s == '#' || *s == '\n') {
+		return;
+	}
+	char op = *s++;
+	uint64_t a = 0, b = 0, c = 0, d = 0;
+	bool ha = poke_num(&s, end, &a), hb = poke_num(&s, end, &b);
+	bool hc = poke_num(&s, end, &c), hd = poke_num(&s, end, &d);
+	volatile uint32_t *r = NULL;
+	if (op != '@' && op != 's') {
+		if (!ha || (a & 3) || !(r = poke_reg(a))) {
+			printf("POKE: line %u: bad address\n", lineno);
+			return;
+		}
+	}
+	switch (op) {
+	case '@': {
+		uint64_t target = a * POKE_TICKS_S;
+		while (mach_absolute_time() < target) {
+			poke_sleep_ms(10);
+		}
+		printf("POKE: @%llu s\n", a);
+		break;
+	}
+	case 's':
+		poke_sleep_ms((unsigned)a);
+		break;
+	case 'r': {
+		uint64_t n = hb ? b : 1;
+		for (uint64_t i = 0; i < n && i < 256; i += 4) {
+			char line[96];
+			int len = snprintf(line, sizeof(line), "POKE: r %09llx:", a + 4 * i);
+			for (uint64_t j = i; j < n && j < i + 4; j++) {
+				volatile uint32_t *rj = poke_reg(a + 4 * j);
+				len += snprintf(line + len, sizeof(line) - len, " %08x", rj ? poke_rd(rj) : 0xdeadbeef);
+			}
+			printf("%s\n", line);
+		}
+		break;
+	}
+	case 'w':
+		poke_wr(r, (uint32_t)b);
+		printf("POKE: w %09llx = %08llx -> %08x\n", a, b, poke_rd(r));
+		break;
+	case 'm': {
+		uint32_t old = poke_rd(r);
+		poke_wr(r, (old & ~(uint32_t)b) | ((uint32_t)c & (uint32_t)b));
+		printf("POKE: m %09llx %08x -> %08x\n", a, old, poke_rd(r));
+		break;
+	}
+	case 'p': {
+		uint64_t ms = hd ? d : 100, t;
+		uint32_t v = 0;
+		for (t = 0; t <= ms; t++) {
+			v = poke_rd(r);
+			if ((v & (uint32_t)b) == (uint32_t)c) {
+				break;
+			}
+			poke_sleep_ms(1);
+		}
+		printf("POKE: p %09llx & %08llx == %08llx: %s after %llu ms (%08x)\n", a, b, c,
+		    t <= ms ? "ok" : "TIMEOUT", t, v);
+		break;
+	}
+	default:
+		printf("POKE: line %u: unknown op '%c'\n", lineno, op);
+	}
+	(void)hc;
+}
+
+/* Run script text in the calling thread (also used by the USB command server). */
+void
+sweet_poke_run(const char *text, unsigned len)
+{
+	const char *s = text, *end = text + len;
+	unsigned lineno = 1;
+	while (s < end && *s) {
+		const char *e = s;
+		while (e < end && *e && *e != '\n') {
+			e++;
+		}
+		poke_line(s, e, lineno++);
+		s = e < end && *e == '\n' ? e + 1 : e;
+	}
+}
+
+static void
+poke_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	printf("POKE: running %u-byte script\n", poke_len);
+	sweet_poke_run(poke_script, poke_len);
+	printf("POKE: done\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_poke_start(void)
+{
+	DTEntry chosen;
+	void const *script;
+	unsigned size;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "sweet-poke", &script, &size) != kSuccess || size < 2) {
+		return;
+	}
+	poke_script = (const char *)script;
+	poke_len = size;
