+/*
+ * A615 core clock. Without the HFI perf table the GMU never moves gpu_cc_gx_gfx3d_clk_src off XO
+ * (19.2 MHz: Turnip's first frames made no progress for 500 ms). Set it from the CPU like downstream
+ * gpucc-sdm845.c (gfxcc): gpu_cc_pll0 (Fabia, GPUCC+0x0) at 860 MHz, gfx3d RCG (+0x101c) source 1 =
+ * crc_div (pll0 even / 2), divider a6_gx_div (1 -> 430 MHz = sdm670 OPP at SVS_L1, the level voted in
+ * BOOT_SLUMBER; 2 -> 215 MHz). Proven live with pokes on 2026-11-01 (PLL locks at once).
+ */
+unsigned a6_gx_div = 1;
+
+static void gx_clock(void)
+{
+	uint64_t pll = GPUCC + 0x0, rcg = GPUCC + 0x101c;
+	if (!a6_gx_div) {
+		return;
+	}
+	wr32(pll, rd32(pll) & ~1u);			/* OUTCTRL off */
+	wr32(pll, rd32(pll) & ~(1u << 21));		/* VOTE_FSM_RESET off */
+	wr32(pll + 0x2c, 0);				/* OPMODE standby */
+	wr32(pll, rd32(pll) & ~4u);			/* RESET_N low */
+	wr32(pll + 0x08, 0x2c);				/* CAL_L */
+	wr32(pll + 0x04, 0x2c);				/* L: 44.79 x 19.2 MHz = 860 MHz */
+	wr32(pll + 0x38, 0xcaaa);			/* FRAC */
+	wr32(pll, rd32(pll) | (1u << 23));		/* UPDATE_BYPASS */
+	wr32(pll, rd32(pll) | 4u);			/* RESET_N */
+	wr32(pll + 0x2c, 1);				/* OPMODE run */
+	int lock = wait_bit(pll, 1u << 31, 1, 100);
+	if (lock) {
+		a6_log("gx clock: pll0 did not lock (mode %x); GPU stays on XO\n", rd32(pll));
+		return;
+	}
+	wr32(pll + 0x0c, rd32(pll + 0x0c) | 7u);	/* USER_CTL: main/even/odd outputs */
+	wr32(pll, rd32(pll) | 1u);			/* OUTCTRL */
+	wr32(rcg + 4, (1u << 8) | (2u * a6_gx_div - 1u));
+	wr32(rcg, rd32(rcg) | 1u);			/* UPDATE */
+	int upd = wait_bit(rcg, 1u, 0, 10);
+	a6_log("gx clock: pll0 860 MHz locked, gfx3d %u MHz (cfg %x cmd %x)%s\n", 430 / a6_gx_div,
+	    rd32(rcg + 4), rd32(rcg), upd ? " UPDATE TIMEOUT" : "");
+}
